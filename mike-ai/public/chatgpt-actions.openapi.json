{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Project Platform — ChatGPT Local Memory",
    "version": "1.0.0",
    "description": "Read and write Michael Paine's local project memory. Prefer newest entries. Do not invent project status."
  },
  "servers": [
    {
      "url": "https://REPLACE_WITH_PUBLISHED_HOST",
      "description": "Published AI Project Platform host"
    }
  ],
  "paths": {
    "/api/memory/chatgpt": {
      "get": {
        "operationId": "getLocalMemory",
        "summary": "Load projects and local memory",
        "description": "Returns the current project list and newest local memory entries for grounding answers.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Local context payload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "generatedAt": { "type": "string", "format": "date-time" },
                    "instruction": { "type": "string" },
                    "projects": { "type": "array", "items": { "type": "object" } },
                    "memory": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "503": { "description": "Memory token not configured" }
        }
      },
      "post": {
        "operationId": "addLocalMemory",
        "summary": "Append a local memory note",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "body"],
                "properties": {
                  "title": { "type": "string", "maxLength": 200 },
                  "body": { "type": "string", "maxLength": 8000 },
                  "projectId": { "type": "string" },
                  "kind": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Saved" },
          "401": { "description": "Unauthorized" },
          "413": { "description": "Payload too large" },
          "503": { "description": "Memory token not configured" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "token",
        "description": "Same value as CHATGPT_MEMORY_TOKEN (min 32 characters)."
      }
    }
  }
}
