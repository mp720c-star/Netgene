# Auth (required for unlock / Face ID session)
PLATFORM_UNLOCK_CODE=
SESSION_SECRET=

# Hosted Postgres — leave empty for local in-memory PGlite.
# Supabase project: ai-project-platform (ref hiynzonbazdorebekrsl)
# Dashboard → Project Settings → Database → Connection string (URI)
# Use the "Transaction" pooler URI for serverless / Cursor publish.
DATABASE_URL=

# Optional public project URL (health / docs only; not a secret)
NEXT_PUBLIC_SUPABASE_URL=https://hiynzonbazdorebekrsl.supabase.co

# Optional — chat stays fail-closed without these
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Optional — paste a full AI_Platform_Project_Records JSON blob if not using recovery/
AI_PLATFORM_PROJECT_RECORDS_JSON=

# Optional comma-separated Origins allowed for POST /api/chat and WebAuthn
ALLOWED_ORIGINS=

# Cloud sync — OneDrive primary; Drive + iCloud replicas (fail-closed when unset)
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
ICLOUD_CLOUDKIT_CONTAINER=
ICLOUD_CLOUDKIT_API_TOKEN=
ICLOUD_CLOUDKIT_ENV=
