// ===================== DIAGNOSTIC RULES =====================
const rules = [
  { keywords:["won't start","does not start","no power"], diagnosis:"Check battery, ignition switch, starter, and fuel supply."},
  { keywords:["squeak","squeaking","noise"], diagnosis:"Check belts, pulleys, brake pads, and suspension components."},
  { keywords:["overheating","hot engine","engine too hot"], diagnosis:"Check coolant level, radiator, fans, and thermostat."},
  { keywords:["engine misfire","stumbles","rough running"], diagnosis:"Check spark plugs, ignition coils, and fuel system."},
  { keywords:["lights not working","headlights","taillights"], diagnosis:"Check fuses, bulbs, and wiring connections."},
  { keywords:["brake failure","soft brakes","brake noise"], diagnosis:"Check brake fluid, pads, rotors, and calipers."},
  { keywords:["transmission","gear slipping","clutch problem"], diagnosis:"Check transmission fluid, clutch system, and linkages."}
];

// ===================== DIAGNOSE FUNCTION =====================
function diagnose(symptom) {
  symptom = symptom.toLowerCase();
  let matches = [];
  for (let rule of rules) {
    for (let kw of rule.keywords) {
      if (symptom.includes(kw)) matches.push(rule.diagnosis);
    }
  }
  return matches.length>0 ? matches.join(" | ") : "No diagnosis found. Please describe more specifically.";
}

// ===================== LOCAL STORAGE HISTORY =====================
function saveHistory(vehicle, symptom, diagnosis) {
  let history = JSON.parse(localStorage.getItem('vehicleGeniusHistory')||'[]');
  history.unshift({vehicle,symptom,diagnosis,date:new Date().toLocaleString()});
  localStorage.setItem('vehicleGeniusHistory',JSON.stringify(history));
  renderHistory();
}

function renderHistory() {
  let history = JSON.parse(localStorage.getItem('vehicleGeniusHistory')||'[]');
  const historyDiv = document.getElementById('history');
  if(history.length===0){historyDiv.innerHTML="No previous diagnoses."; return;}
  historyDiv.innerHTML = history.map(h=>`<div style="border-bottom:1px solid #444; padding:5px;">
    <b>${h.date}</b><br>
    <b>Vehicle:</b> ${h.vehicle}<br>
    <b>Symptom:</b> ${h.symptom}<br>
    <b>Diagnosis:</b> ${h.diagnosis}
  </div>`).join('');
}

renderHistory();

// ===================== POPULATE SELECTS =====================
const typeSelect = document.getElementById('vehicleType');
const brandSelect = document.getElementById('vehicleBrand');
const modelSelect = document.getElementById('vehicleModel');

typeSelect.addEventListener('change', function() {
  const type = this.value;
  brandSelect.innerHTML = '<option value="">-- Select Brand --</option>';
  modelSelect.innerHTML = '<option value="">-- Select Model --</option>';
  if (!vehicles[type]) return;
  Object.keys(vehicles[type]).forEach(brand => {
    brandSelect.innerHTML += `<option value="${brand}">${brand}</option>`;
  });
});

brandSelect.addEventListener('change', function() {
  const type = typeSelect.value;
  const brand = this.value;
  modelSelect.innerHTML = '<option value="">-- Select Model --</option>';
  if (!vehicles[type] || !vehicles[type][brand]) return;
  vehicles[type][brand].forEach(model => {
    modelSelect.innerHTML += `<option value="${model}">${model}</option>`;
  });
});

// ===================== VOICE INPUT =====================
document.getElementById('voiceBtn').addEventListener('click', () => {
  if (!('webkitSpeechRecognition' in window)) {
    alert("Voice recognition not supported on this device.");
    return;
  }
  const recognition = new webkitSpeechRecognition();
  recognition.lang = 'en-US';
  recognition.onresult = (event) => {
    document.getElementById('symptom').value = event.results[0][0].transcript;
  };
  recognition.start();
});

// ===================== DIAGNOSE BUTTON =====================
document.getElementById('diagnoseBtn').addEventListener('click', () => {
  const type = typeSelect.value;
  const brand = brandSelect.value;
  const model = modelSelect.value;
  const vehicle = type && brand && model ? `${type} - ${brand} ${model}` : "Unknown Vehicle";
  const symptom = document.getElementById('symptom').value.trim();
  if(!symptom){alert("Please enter a symptom."); return;}
  const result = diagnose(symptom);
  document.getElementById('results').innerText = result;
  saveHistory(vehicle,symptom,result);
});

// ===================== CAMERA =====================
document.getElementById('startCameraBtn').addEventListener('click', () => {
  navigator.mediaDevices.getUserMedia({video:true})
    .then(stream => { document.getElementById('videoElement').srcObject = stream; })
    .catch(err => { alert("Camera access denied: " + err); });
});

// ===================== END OF SCRIPT =====================
</script>
</body>
</html>